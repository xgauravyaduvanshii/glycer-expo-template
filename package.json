{
  "name": "glycer-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/expo-logger.js start",
    "android": "node scripts/expo-logger.js start --android",
    "ios": "node scripts/expo-logger.js start --ios",
    "web": "node scripts/expo-logger.js start --web",
    "dev": "./scripts/start-dev.sh",
    "backend": "bun run backend/hono.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:studio": "bunx --bun prisma studio --port 5555 --hostname 0.0.0.0",
    "convex:dev": "CONVEX_AGENT_MODE=anonymous npx convex dev",
    "convex:deploy": "npx convex deploy",
    "prewarm": "node scripts/prewarm-bundle.js",
    "lint": "expo lint",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
